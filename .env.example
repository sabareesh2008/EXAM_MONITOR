# Official VSB Karur Controller of Examinations page
COE_URL=https://vsbec.edu.in/controller-of-examination/
MONITOR_URLS=https://vsbec.edu.in/controller-of-examination/,https://vsbec.edu.in/,https://coe.vsbec.edu.in/
POLL_INTERVAL_MINUTES=5
REQUEST_TIMEOUT_SECONDS=30
USER_AGENT=VSBExamWatch/2.0 (personal academic notice monitor)

# Personal profile - fill these locally; never commit .env to GitHub
REGISTER_NUMBER=YOUR_REGISTER_NUMBER
STUDENT_NAME=
DEPARTMENT=ECE
NOTIFICATION_EMAIL=your-email@example.com

# Gmail SMTP: use a Google App Password, never your normal Gmail password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=YOUR_16_CHARACTER_APP_PASSWORD

# Dashboard security. Set a strong password before cloud deployment.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_SECRET=replace-with-a-long-random-secret
DASHBOARD_PASSWORD=replace-with-a-strong-dashboard-password

DATABASE_PATH=data/vsb_exam_watch.sqlite3
DOWNLOAD_DIR=data/downloads
EVIDENCE_DIR=data/evidence
LOG_DIR=data/logs
